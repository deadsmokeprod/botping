# Admin bot (this process uses it for commands + alerts)
ADMIN_BOT_TOKEN=123456:ABC-DEF...

# Comma-separated Telegram user IDs allowed to control the bot
ADMIN_CHAT_IDS=123456789

# SQLite database path (created automatically). In Docker use e.g. /app/data/botping.db
DATABASE_PATH=./data/botping.db

# Optional: logging level DEBUG|INFO|WARNING|ERROR
LOG_LEVEL=INFO

# Public address of this Botping instance.
# Используется только чтобы сниппет для ваших ботов подставлял правильный URL.
# Укажите один из двух:
#   BOTPING_PUBLIC_HOST — IP или домен (снежинка пропишет http://<host>:<port>)
#   BOTPING_PUBLIC_URL  — полный URL со схемой (если уже есть HTTPS)
# BOTPING_PUBLIC_HOST=198.51.100.42
# BOTPING_PUBLIC_URL=https://botping.example.com
# HEARTBEAT_PORT=8080

# SSH на VPS, где развёрнут Botping (для обновления с вашей машины; не коммитится)
# DEPLOY_SSH_HOST=203.0.113.10
# DEPLOY_SSH_USER=root
# DEPLOY_SSH_PASSWORD=
# DEPLOY_SSH_PORT=22
# DEPLOY_PATH=/opt/botping
