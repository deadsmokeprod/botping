[Unit]
Description=Botping Telegram bot monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botping
Group=botping
WorkingDirectory=/opt/botping
EnvironmentFile=/opt/botping/.env
ExecStart=/opt/botping/venv/bin/python -m botping.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
